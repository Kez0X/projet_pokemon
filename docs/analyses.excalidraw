  {
   "id": "0zsbffayr3rx",
   "type": "text",
   "x": 2068,
   "y": 576,
   "width": 511.50000000000006,
   "height": 112.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
