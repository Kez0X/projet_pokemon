  {
   "id": "8jd6u7inu54v",
   "type": "text",
   "x": 28,
   "y": 1380,
   "width": 511.50000000000006,
   "height": 150.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
