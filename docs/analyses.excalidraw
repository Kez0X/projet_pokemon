  {
   "id": "nlsj8mrtq2k8",
   "type": "text",
   "x": 708,
   "y": 612,
   "width": 271.15000000000003,
   "height": 21.25,
   "angle": 0,
   "strokeColor": "#2f9e44",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
