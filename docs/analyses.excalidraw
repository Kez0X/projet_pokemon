   "link": null,
   "locked": false
  },
  {
   "id": "wy6k8c7fqgrf",
   "type": "text",
   "x": 708,
   "y": 294,
   "width": 177.65,
   "height": 21.25,
   "angle": 0,
   "strokeColor": "#1971c2",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
