  {
   "id": "wihqjcwefgtu",
   "type": "text",
   "x": 28,
   "y": 1598,
   "width": 503.25000000000006,
   "height": 225.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
