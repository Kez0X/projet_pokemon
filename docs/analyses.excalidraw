  {
   "id": "bel3y6sjj7gq",
   "type": "text",
   "x": 708,
   "y": 1380,
   "width": 495.00000000000006,
   "height": 112.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
