   "updated": 1795000000000,
   "link": null,
   "locked": false
  },
  {
   "id": "vvx9cxe5f82v",
   "type": "text",
   "x": 1388,
   "y": 1554,
   "width": 177.65,
   "height": 21.25,
   "angle": 0,
   "strokeColor": "#1971c2",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
