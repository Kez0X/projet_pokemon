   "x": 1376,
   "y": 306,
   "width": 568,
   "height": 246,
   "angle": 0,
   "strokeColor": "#1971c2",
   "backgroundColor": "#e7f5ff",
   "fillStyle": "solid",
   "strokeWidth": 2,
